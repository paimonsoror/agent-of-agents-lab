{
  "realm": "maestro",
  "displayName": "Maestro fleet",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 28800,
  "accessTokenLifespanForImplicitFlow": 28800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "maestro:ask",
        "description": "May ask Maestro (the orchestrator) a question"
      },
      {
        "name": "domain:apim",
        "description": "May consult the API-management domain agent"
      },
      {
        "name": "domain:cache",
        "description": "May consult the distributed-cache domain agent"
      },
      {
        "name": "domain:messaging",
        "description": "May consult the messaging domain agent"
      }
    ]
  },
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "clientScopes": [
