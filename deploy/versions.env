# Single source of truth for every third-party version. Verified 2026-10-15.
# Sourced by scripts/*.sh and passed to Helm as --set values.

KIND_NODE_IMAGE=kindest/node:v1.37.0

# Gateways (fleet + edge)
AGENTGATEWAY_CHART_VERSION=v1.6.0
AGENTGATEWAY_IMAGE_TAG=v1.6.0

# Shared monitoring
KUBE_PROMETHEUS_STACK_VERSION=92.9.0

# Identity
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1

# Domain platforms
VALKEY_IMAGE=valkey/valkey:9.1.2
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.94.0
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.10.0

# First-party images are built from python:3.13-slim
PYTHON_BASE_IMAGE=python:3.13-slim

# Init containers that wait for dependencies
BUSYBOX_IMAGE=busybox:1.37.0
